<Window x:Class="VoltDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:VoltDesk.Desktop.Services"
        xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="VoltDesk" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="VoltDesk" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Projects, tasks and panel schedules for an electrical design studio"
                       Foreground="Gray" Margin="0,4,0,28" HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="Gray" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Health}" Value="{x:Static services:ApiHealth.Healthy}">
                                    <Setter Property="Fill" Value="#2E7D32" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Health}" Value="{x:Static services:ApiHealth.DatabaseUnavailable}">
                                    <Setter Property="Fill" Value="#ED6C02" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Health}" Value="{x:Static services:ApiHealth.Unreachable}">
                                    <Setter Property="Fill" Value="#D32F2F" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Content="Check again" Command="{Binding CheckConnectionCommand}"
                    Padding="16,6" Margin="0,16,0,0" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
