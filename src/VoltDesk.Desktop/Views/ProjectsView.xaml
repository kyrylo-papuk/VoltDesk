<UserControl x:Class="VoltDesk.Desktop.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel}">
    <DockPanel Margin="32,28">
        <Grid DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Projects" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="+  New project" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding NewProjectCommand}"
                    Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}"
                    AutomationProperties.AutomationId="NewProject" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,14">
            <TextBox Width="300" Tag="Search by number, name or client"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="ProjectSearch" />
            <ComboBox Width="170" Margin="10,0,0,0"
                      ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding StatusFilter}" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                      AutomationProperties.AutomationId="ProjectsGrid">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenSelectedCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NUMBER" Binding="{Binding Project.Number}" Width="100" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="PROJECT" Binding="{Binding Project.Name}" Width="2*" />
                    <DataGridTextColumn Header="CLIENT" Binding="{Binding Project.ClientName}" Width="1.6*" />
                    <DataGridTemplateColumn Header="STAGE" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoftBrush}"
                                        ToolTip="{Binding Project.Stage, Converter={StaticResource EnumDisplay}}">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="#1D4ED8"
                                               Text="{Binding Project.Stage, Converter={StaticResource EnumDisplay}, ConverterParameter=abbr}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}"
                                        Background="{Binding Project.Status, Converter={StaticResource StatusBrush}}">
                                    <TextBlock Style="{StaticResource BadgeText}"
                                               Foreground="{Binding Project.Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"
                                               Text="{Binding Project.Status, Converter={StaticResource EnumDisplay}}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="MANAGER" Binding="{Binding Project.ProjectManagerName}" Width="1.2*" />
                    <DataGridTextColumn Header="OPEN TASKS" Binding="{Binding Project.OpenTasks}" Width="95" />
                    <DataGridTemplateColumn Header="STAGE DUE" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectRow}">
                                <TextBlock Text="{Binding StageDueText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStageOverdue}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="FEE" Binding="{Binding FeeText}" Width="95" />
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Open →" Style="{StaticResource LinkButton}"
                                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="{Binding Project.Number, StringFormat=Open {0}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
