<UserControl x:Class="VoltDesk.Desktop.Views.TaskBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TaskBoardViewModel}">
    <DockPanel Margin="32,28">
        <Grid DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Task board" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Active projects only. Drag cards between columns or use the arrows."
                           Style="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Content="Workload → Google Sheets" Margin="0,0,130,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding ExportWorkloadCommand}"
                    Visibility="{Binding CanExportWorkload, Converter={StaticResource VisibleWhen}}"
                    AutomationProperties.AutomationId="ExportWorkload" />
            <Button Content="+  New task" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding NewTaskCommand}"
                    Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}"
                    AutomationProperties.AutomationId="NewTask" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,20,0,14">
            <ComboBox Width="340" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding ProjectFilter}" AutomationProperties.AutomationId="BoardProject" />
            <ComboBox Width="200" Margin="10,0,0,0" ItemsSource="{Binding AssigneeOptions}" DisplayMemberPath="Label"
                      SelectedItem="{Binding AssigneeFilter}" AutomationProperties.AutomationId="BoardAssignee" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                       AutomationProperties.AutomationId="Error" />
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,12"
                Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Columns -->
            <ItemsControl ItemsSource="{Binding Columns}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BoardColumn}">
                        <Border Margin="0,0,12,0" Padding="10" CornerRadius="8" Background="#EEF2F6"
                                AllowDrop="True" DragOver="OnColumnDragOver" Drop="OnColumnDrop"
                                AutomationProperties.AutomationId="{Binding Title, StringFormat=Column {0}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,0,10">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource Badge}" Background="White" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding Cards.Count}" Style="{StaticResource BadgeText}" Foreground="{StaticResource MutedBrush}"
                                                   AutomationProperties.AutomationId="{Binding Title, StringFormat=Count {0}}"
                                                   AutomationProperties.Name="{Binding Cards.Count}" />
                                    </Border>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Cards}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:TaskCard}">
                                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="8" Background="White" BorderThickness="1"
                                                        Cursor="Hand"
                                                        MouseLeftButtonDown="OnCardMouseDown" MouseMove="OnCardMouseMove">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                                                    Background="{StaticResource DangerSoftBrush}"
                                                                    Visibility="{Binding IsHighPriority, Converter={StaticResource VisibleWhen}}">
                                                                <TextBlock Text="High" Style="{StaticResource BadgeText}" Foreground="#B91C1C" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Task.ProjectNumber}" Style="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold" />
                                                        </DockPanel>
                                                        <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource TextBrush}"
                                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,4,0,8"
                                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                AutomationProperties.AutomationId="{Binding AutomationKey}">
                                                            <TextBlock Text="{Binding Task.Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                        </Button>
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                <Button Content="‹" Style="{StaticResource LinkButton}" Padding="6,0" FontSize="15"
                                                                        ToolTip="Move to the previous column"
                                                                        Command="{Binding DataContext.MoveLeftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat={}{0} left}" />
                                                                <Button Content="›" Style="{StaticResource LinkButton}" Padding="6,0" FontSize="15"
                                                                        ToolTip="Move to the next column"
                                                                        Command="{Binding DataContext.MoveRightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        AutomationProperties.AutomationId="{Binding AutomationKey, StringFormat={}{0} right}" />
                                                                <Border Width="26" Height="26" CornerRadius="13" Margin="6,0,0,0"
                                                                        Background="{StaticResource AccentSoftBrush}" ToolTip="{Binding Task.AssigneeName, TargetNullValue=Unassigned}">
                                                                    <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding DueText}">
                                                                <Run Text="{Binding Task.Discipline, Mode=OneWay, Converter={StaticResource EnumDisplay}}" Foreground="{StaticResource MutedBrush}" />
                                                                <Run Text=" · " Foreground="{StaticResource MutedBrush}" />
                                                                <Run Text="{Binding DueText, Mode=OneWay}">
                                                                    <Run.Style>
                                                                        <Style TargetType="Run">
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Run.Style>
                                                                </Run>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Details of the selected card -->
            <Border Grid.Column="1" Width="280" Margin="4,0,0,0" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCard.Task.ProjectNumber}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,14">
                        <Run Text="{Binding SelectedCard.Task.Stage, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                        <Run Text=" · " />
                        <Run Text="{Binding SelectedCard.Task.Discipline, Mode=OneWay, Converter={StaticResource EnumDisplay}}" />
                    </TextBlock>

                    <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditTitle" />

                    <TextBlock Text="Assignee" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding Assignees}" DisplayMemberPath="Label" SelectedItem="{Binding EditAssignee}"
                              AutomationProperties.AutomationId="EditAssignee" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding EditPriority}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                            <DatePicker SelectedDate="{Binding EditDueDate, Converter={StaticResource DateOnly}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SelectedCard.Task.Description}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                               Margin="0,12,0,0" Visibility="{Binding SelectedCard.Task.Description, Converter={StaticResource VisibleWhen}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                                AutomationProperties.AutomationId="SaveTask" />
                        <Button Content="Assign to me" Margin="8,0,0,0" Command="{Binding AssignToMeCommand}"
                                AutomationProperties.AutomationId="AssignToMe" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
