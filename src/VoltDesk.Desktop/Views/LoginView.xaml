<UserControl x:Class="VoltDesk.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
             xmlns:services="clr-namespace:VoltDesk.Desktop.Services"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="420" Padding="36,32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontSize="26" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="VoltDesk" FontSize="26" FontWeight="Bold" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="Sign in to the studio workspace" Style="{StaticResource Muted}" Margin="0,4,0,24" />

                <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="Email" />

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                             AutomationProperties.AutomationId="Password" />

                <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                </Border>

                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Margin="0,20,0,0" Padding="14,10"
                        Command="{Binding SignInCommand}"
                        AutomationProperties.AutomationId="SignIn" />

                <StackPanel Margin="0,24,0,0" Visibility="{Binding HasDemoAccounts, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="DEMO ACCOUNTS" Style="{StaticResource FieldLabel}" />
                    <ItemsControl ItemsSource="{Binding DemoAccounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DemoAccount}">
                                <Button Content="{Binding Label}" Margin="0,0,6,0" Padding="6,7" FontWeight="Normal"
                                        Command="{Binding DataContext.UseDemoAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.AutomationId="{Binding Label, StringFormat=Demo {0}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ServerHealth}" Value="{x:Static services:ApiHealth.Healthy}">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ServerHealth}" Value="{x:Static services:ApiHealth.DatabaseUnavailable}">
                                        <Setter Property="Fill" Value="{StaticResource BrandBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ServerHealth}" Value="{x:Static services:ApiHealth.Unreachable}">
                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ServerStatus}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
