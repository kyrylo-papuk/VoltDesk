<Window x:Class="VoltDesk.Desktop.Views.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewTaskViewModel}"
        Title="New task" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="{StaticResource AppBackgroundBrush}">
    <StackPanel Margin="28,24">
        <TextBlock Text="New task" Style="{StaticResource PageTitle}" FontSize="19" />
        <TextBlock Text="The task joins the current design stage of the project." Style="{StaticResource Muted}" Margin="0,4,0,20" />

        <TextBlock Text="Project" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" AutomationProperties.AutomationId="TaskProject">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Name, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TaskTitle" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Discipline" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Disciplines}" SelectedItem="{Binding Discipline}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />
            </StackPanel>
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Due date" Style="{StaticResource FieldLabel}" />
                <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnly}}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Estimate, hours" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding EstimatedHours, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="70"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,6" />

        <Border Style="{StaticResource ErrorBanner}" Margin="0,18,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Create task" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Command="{Binding CreateCommand}" AutomationProperties.AutomationId="CreateTask" />
        </StackPanel>
    </StackPanel>
</Window>
