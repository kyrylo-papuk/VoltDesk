<UserControl x:Class="VoltDesk.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
             xmlns:contracts="clr-namespace:VoltDesk.Contracts;assembly=VoltDesk.Contracts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ClientsViewModel}">
    <DockPanel Margin="32,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Clients" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Customer companies and the people we work with" Style="{StaticResource Muted}" Margin="0,4,0,18" />
            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,12"
                    Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
            </Border>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Client list -->
            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBox DockPanel.Dock="Top" Tag="Search clients or contacts" Margin="0,0,0,10"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0"
                          Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Tag="New client name" Text="{Binding NewClientName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                Command="{Binding AddClientCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                             BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type contracts:ClientSummaryDto}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
                                        <Run Text="{Binding PrimaryContactName, Mode=OneWay, TargetNullValue=No contact yet}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding ActiveProjects, Mode=OneWay}" />
                                        <Run Text="active projects" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Selected client -->
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Client, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <TextBlock Text="{Binding Client.Name}" Style="{StaticResource PageTitle}" FontSize="19" Margin="0,0,0,16" />
                    <TextBlock Text="Contacts" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding Client.Contacts}" MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="1.3*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.3*" />
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.6*" />
                            <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="1.1*" />
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoftBrush}"
                                                Visibility="{Binding IsPrimary, Converter={StaticResource VisibleWhen}}">
                                            <TextBlock Text="Primary" Style="{StaticResource BadgeText}" Foreground="#1D4ED8" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Remove" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource VisibleWhen}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Margin="0,22,0,0" Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Add a contact" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="10" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBox Tag="Full name *" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Tag="Title" Text="{Binding ContactTitle, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="2" Tag="Email" Text="{Binding ContactEmail, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Row="2" Grid.Column="2" Tag="Phone" Text="{Binding ContactPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <CheckBox Content="Primary contact" IsChecked="{Binding ContactIsPrimary}" VerticalAlignment="Center" />
                            <Button Content="Add contact" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"
                                    Command="{Binding AddContactCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
