<UserControl x:Class="VoltDesk.Desktop.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:VoltDesk.Desktop.ViewModels"
             xmlns:contracts="clr-namespace:VoltDesk.Contracts;assembly=VoltDesk.Contracts"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectDetailViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,22,32,32">
            <Button Content="← All projects" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                    Command="{Binding BackCommand}" AutomationProperties.AutomationId="Back" />

            <!-- Header -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Project.Number}" Style="{StaticResource PageTitle}" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding Project.Name}" Style="{StaticResource PageTitle}" Margin="10,0,12,0" />
                        <Border Style="{StaticResource Badge}"
                                Background="{Binding Project.Status, Converter={StaticResource StatusBrush}}">
                            <TextBlock Style="{StaticResource BadgeText}"
                                       Foreground="{Binding Project.Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"
                                       Text="{Binding Project.Status, Converter={StaticResource EnumDisplay}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding CanManage, Converter={StaticResource VisibleWhen}}">
                    <Button Content="Close stage" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding AdvanceCommand}"
                            Visibility="{Binding CanAdvance, Converter={StaticResource VisibleWhen}}"
                            ToolTip="Close the current design stage and move to the next one"
                            AutomationProperties.AutomationId="Advance" />
                    <Button Content="Put on hold" Margin="0,0,8,0" Command="{Binding HoldCommand}"
                            Visibility="{Binding CanHold, Converter={StaticResource VisibleWhen}}" />
                    <Button Content="Resume" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding ResumeCommand}"
                            Visibility="{Binding CanResume, Converter={StaticResource VisibleWhen}}" />
                    <Button Content="Cancel project" Style="{StaticResource DangerButton}" Command="{Binding CancelProjectCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                           AutomationProperties.AutomationId="Error" />
            </Border>
            <Border Style="{StaticResource InfoBanner}" Margin="0,16,0,0"
                    Visibility="{Binding InfoMessage, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding InfoMessage}" TextWrapping="Wrap" Foreground="{StaticResource SuccessBrush}" />
            </Border>

            <!-- Stage timeline -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Design stages" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Milestones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MilestoneRow}">
                                <Border Margin="0,0,10,0" Padding="14,12" CornerRadius="8" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter Property="Background" Value="#F8FAFF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Milestone.Stage, Converter={StaticResource EnumDisplay}, ConverterParameter=abbr}"
                                                       FontWeight="Bold" FontSize="15" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                    Background="{Binding State, Converter={StaticResource StatusBrush}}">
                                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding StateText}"
                                                           Foreground="{Binding State, Converter={StaticResource StatusBrush}, ConverterParameter=fg}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Milestone.Stage, Converter={StaticResource EnumDisplay}}"
                                                   Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,10" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="Due" Style="{StaticResource FieldLabel}" />
                                        <DatePicker SelectedDate="{Binding DueDate, Converter={StaticResource DateOnly}}"
                                                    IsEnabled="{Binding IsEditable}" />
                                        <Button Content="Save date" Margin="0,8,0,0" Padding="10,5"
                                                Command="{Binding DataContext.SaveMilestoneCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsChanged, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Panel schedules -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Panel schedules" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="No panels yet." Style="{StaticResource Muted}" Margin="0,0,0,8"
                               Visibility="{Binding Panels.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Panels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type contracts:PanelSummaryDto}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding TotalKva, StringFormat={}{0:0.0} kVA}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding ImbalancePercent, StringFormat={}{0:0.#} % imbalance}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="#D97706"
                                               Text="{Binding WarningCount, StringFormat={}{0} warnings}"
                                               Visibility="{Binding WarningCount, Converter={StaticResource VisibleWhen}}" />
                                    <Button Grid.Column="5" Content="Open →" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.OpenPanelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.AutomationId="{Binding Name, StringFormat=Open panel {0}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding CanEditPanels, Converter={StaticResource VisibleWhen}}">
                        <TextBox Width="140" Tag="Panel name" Text="{Binding NewPanelName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="NewPanelName" />
                        <ComboBox Width="190" Margin="8,0,0,0" ItemsSource="{Binding VoltageSystems}" SelectedItem="{Binding NewPanelSystem}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Width="110" Margin="8,0,0,0" ItemsSource="{Binding BusRatings}" SelectedItem="{Binding NewPanelBus}"
                                  ItemStringFormat="{}{0} A bus" />
                        <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding SpaceOptions}" SelectedItem="{Binding NewPanelSpaces}"
                                  ItemStringFormat="{}{0} spaces" />
                        <Button Content="Add panel" Margin="8,0,0,0" Command="{Binding CreatePanelCommand}"
                                AutomationProperties.AutomationId="AddPanel" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tasks and history -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Tasks" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="No tasks yet." Style="{StaticResource Muted}"
                                   Visibility="{Binding TaskGroups.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding TaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TaskGroup}">
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type contracts:TaskDto}">
                                                    <Grid Margin="0,0,0,1" Background="{StaticResource SurfaceBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="130" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource Badge}" Margin="0,5"
                                                                Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                                            <TextBlock Style="{StaticResource BadgeText}"
                                                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"
                                                                       Text="{Binding Status, Converter={StaticResource EnumDisplay}}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Discipline, Converter={StaticResource EnumDisplay}}"
                                                                   Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                                   Text="{Binding AssigneeName, TargetNullValue=Unassigned}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="History" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding History}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryRow}">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock>
                                            <Run Text="{Binding Who, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding What, Mode=OneWay}" />
                                            <Run Text="{Binding When, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
